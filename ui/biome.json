{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "files": { "includes": ["src/**", "!src/routeTree.gen.ts", "!src/api/schema.d.ts", "!src/**/*.css"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "recommended": true, "suspicious": { "noExplicitAny": "off" }, "a11y": { "useKeyWithClickEvents": "off", "noStaticElementInteractions": "off" } } },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
