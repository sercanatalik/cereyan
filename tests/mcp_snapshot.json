      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "name": "list_rules"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "The schedules of one flow or of every flow: the spec, whether it is active, when it next fires, and whether it was declared in the flow's code, created in the interface, or created by an agent. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "flow": {
            "description": "Flow name, or project/flow when the name exists in several projects",
            "type": "string"
          },
          "project": {
            "description": "Only schedules of this project",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "list_schedules"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "Everything needed to diagnose a run in one call: the run, its failed or crashed task runs, the last warning-or-above log lines, and the run's events. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "integer"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "explain_failure"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Start a run of a flow now, or at a later time with `at` or `delay_seconds`. Creates the run immediately and returns without waiting; follow it with get_run. Parameters are validated against the flow's schema.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "description": "Start at this time, ISO 8601, instead of now",
            "type": "string"
          },
          "delay_seconds": {
            "description": "Start this many seconds from now; not with at",
            "minimum": 0,
            "type": "number"
          },
          "flow": {
            "description": "Flow name, or project/flow when the name exists in several projects",
            "type": "string"
          },
          "name": {
            "description": "Optional run name",
            "type": "string"
          },
          "parameters": {
            "description": "Flow parameters as JSON",
            "type": "object"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "flow"
        ],
        "type": "object"
      },
      "name": "run_flow"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false
      },
      "description": "Cancel a run. A queued run is cancelled at once; a running run is asked to stop and killed after the grace period.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "integer"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "cancel_run"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Answer a Paused run's wait_for_input question and schedule its next attempt. The answer can be any JSON.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "input": {
            "description": "The answer, any JSON"
          },
          "run_id": {
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "input"
        ],
        "type": "object"
      },
      "name": "resume_run"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Create one run per value of a date or datetime parameter between start and end. Defaults to a dry run that only reports how many runs would be created; pass dry_run false to create them. Can create thousands of runs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "concurrency": {
            "default": 1,
            "type": "integer"
          },
          "dry_run": {
            "default": true,
            "type": "boolean"
          },
          "end": {
            "type": "string"
          },
          "extra_parameters": {
            "type": "object"
          },
          "flow": {
            "description": "Flow name, or project/flow when the name exists in several projects",
            "type": "string"
          },
          "interval": {
            "description": "Seconds or a duration such as 1d or 12h (default 1d)",
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "reverse": {
            "type": "boolean"
          },
          "start": {
            "description": "YYYY-MM-DD or RFC 3339",
            "type": "string"
          }
        },
        "required": [
          "flow",
          "parameter",
          "start",
          "end"
        ],
        "type": "object"
      },
      "name": "backfill"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Make a flow run repeatedly. To run a flow once, now, use run_flow instead: a flow needs no schedule, and running on demand is the normal case. Returns the schedule and the next few times it will fire.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "description": "Microseconds UTC the interval counts from; defaults to now",
            "type": "integer"
          },
          "catchup": {
            "default": "skip",
            "enum": [
              "skip",
              "latest",
              "all"
            ],
            "type": "string"
          },
          "catchup_max": {
            "default": 100,
            "type": "integer"
          },
          "catchup_window": {
            "description": "Seconds; missed fires older than this are not caught up (0 is off)",
            "type": "integer"
          },
          "cron": {
            "description": "Five-field cron expression, for kind cron",
            "type": "string"
