  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "List the registered flows with their project, parameters schema, tags, and any registration error. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "group": {
            "description": "Only flows of this group: the one a flow declared, else its project",
            "type": "string"
          },
          "project": {
            "description": "Only flows of this project",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "list_flows"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "List runs, newest first, with optional filters. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "description": "Comma-separated key=value pairs the run's attributes (set_attributes) must match",
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "group": {
            "description": "Only runs of flows in this group: the one a flow declared, else its project",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "description": "Exact run name",
            "type": "string"
          },
          "params": {
            "description": "Comma-separated key=value pairs the run's parameters must match, e.g. day=2026-09-01; searches the last 30 days unless start bounds are given",
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "state_name": {
            "description": "A named sub-state such as Late or AwaitingRetry",
            "type": "string"
          },
          "state_type": {
            "description": "Scheduled, Pending, Running, Completed, Failed, Cancelled, Crashed, Paused, Cancelling",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "list_runs"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "One run with its state, parameters, timing, and task runs. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "integer"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "get_run"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "What changed between two runs: parameters and attributes, duration, each task's state and duration, the first task that diverged, error lines and the failure message new on the second run, and artifact differences. The first run is the baseline. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "other_run_id": {
            "description": "The run in question",
            "type": "integer"
          },
          "run_id": {
            "description": "The baseline, usually the last good run",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "other_run_id"
        ],
        "type": "object"
      },
      "name": "compare_runs"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "Log lines of a run, oldest first. Filter by minimum level (10 debug, 20 info, 30 warning, 40 error) or a search string. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 200,
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "min_level": {
            "type": "integer"
          },
          "run_id": {
            "type": "integer"
          },
          "search": {
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object"
      },
      "name": "run_logs"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "Recent events (run and task transitions, schedule changes, rule firings, custom events), newest first. Read-only.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "flow_id": {
            "type": "integer"
          },
          "limit": {
            "default": 50,
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
