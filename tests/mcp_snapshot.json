{
  "handshake": {
    "capabilities": {
      "prompts": {},
      "resources": {},
      "tools": {}
    },
    "instructions": "cereyan runs Python pipelines on this machine. Use list_flows to see what can run, run_flow to start work, get_run and run_logs to follow it, and explain_failure when a run fails. Flows run on demand: a flow needs no schedule, and run_flow is how work usually starts. For work that should recur, list_schedules shows what is scheduled and the create, edit, delete, pause and resume schedule tools manage it. Writes take effect immediately.",
    "protocolVersion": "2025-06-18",
    "serverInfo": {
      "name": "cereyan"
    }
  },
  "prompt_messages": {
    "diagnose_run": [
      {
        "content": {
          "text": "Run <run_id> of a cereyan pipeline needs a diagnosis. Call the explain_failure tool with run_id <run_id>, read the failed task runs, the error log lines, and the events, then summarise the root cause in two sentences and suggest one concrete next step (rerun with run_flow, fix the code, or adjust a schedule).",
          "type": "text"
        },
        "role": "user"
      }
    ]
  },
  "prompts": [
    {
      "arguments": [
        {
          "description": "The run id",
          "name": "run_id",
          "required": true
        }
      ],
      "description": "Explain why a run failed and what to do about it",
      "name": "diagnose_run"
    },
    {
      "arguments": [],
      "description": "Report what needs attention on this server: engines, queue, failed runs, and schedules",
      "name": "health_check"
    },
    {
      "arguments": [
        {
          "description": "Flow name, or project/flow",
          "name": "flow",
          "required": true
        },
        {
          "description": "The date or datetime parameter",
          "name": "parameter",
          "required": true
        },
        {
          "description": "First value, YYYY-MM-DD or RFC 3339",
          "name": "start",
          "required": true
        },
        {
          "description": "Last value, inclusive",
          "name": "end",
          "required": true
        }
      ],
      "description": "Plan a backfill as a dry run, review the range and count, then create the runs",
      "name": "plan_backfill"
    }
  ],
  "resource_templates": [
    {
      "description": "Log lines of a run as JSON",
      "mimeType": "application/json",
      "name": "Run logs",
      "uriTemplate": "cereyan://runs/{id}/logs"
    },
    {
      "description": "Artifacts of a run as JSON",
      "mimeType": "application/json",
      "name": "Run artifacts",
      "uriTemplate": "cereyan://runs/{id}/artifacts"
    }
  ],
